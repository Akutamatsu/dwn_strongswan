connections {
  ikev2-test {
    version = 2
    proposals = @PROPOSAL@
    local_addrs = @RESPONDER_IPV6@
    remote_addrs = %any

    local {
      auth = pubkey
      certs = serverCert.pem
      id = responder
    }
    remote {
      auth = pubkey
      id = initiator
    }
  }

  # Keep inbound IPv6 SSH management traffic outside IPsec processing.
  bypass-ssh {
    children {
      bypass-ssh {
        local_ts = ::/0[tcp/22]
        remote_ts = ::/0[tcp]
        mode = pass
        start_action = trap
      }
    }
  }
}

secrets {
  private {
    file = serverKey.pem
  }
}
